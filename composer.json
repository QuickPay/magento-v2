{
  "name": "quickpay/magento2",
  "description": "Implements integration with the QuickPay payment service provider.",
  "authors": [
    {
      "name": "Codemakers",
      "email": "domas@codemakers.dk"
    }
  ],
  "require": {
    "quickpay/quickpay-php-client": "^2.0"
  },
  "type": "magento2-module",
  "license": [
    "OSL-3.0",
    "AFL-3.0"
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "QuickPay\\Gateway\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
